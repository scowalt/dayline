#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
host=${DAYLINE_SIM_HOST-minith}
device=${DAYLINE_SIM_DEVICE:-dayline-sim}
device_type=${DAYLINE_SIM_DEVICE_TYPE:-com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro}
bundle_id=com.scowalt.dayline
remote_dir=dayline-sim/$device

remote() {
  local script
  script="set -- $(printf '%q ' "$@")"$'\n'"$(cat)"
  if [[ -z $host ]]; then
    bash -s <<<"$script"
  else
    ssh -o BatchMode=yes -o RemoteCommand=none -T "$host" bash -s <<<"$script"
  fi
}

# shellcheck disable=SC2016
prelude='export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH
set -euo pipefail
udid() { xcrun simctl list devices -j | jq -r --arg n "$1" ".devices[][] | select(.name == \$n and .isAvailable) | .udid" | head -1; }'

build() {
  (cd "$root" && xtool dev build --triple arm64-apple-ios-simulator "$@")
}

ship() {
  local app="$root/xtool/Dayline.app"
  if [[ -z $host ]]; then
    mkdir -p "$HOME/$remote_dir"
    rsync -a --delete "$app/" "$HOME/$remote_dir/Dayline.app/"
  else
    remote <<<"mkdir -p ~/$remote_dir"
    rsync -a --delete -e "ssh -o BatchMode=yes -o RemoteCommand=none -T" "$app/" "$host:$remote_dir/Dayline.app/"
  fi
}

boot() {
  remote "$device" "$device_type" <<EOF
$prelude
id=\$(udid "\$1")
if [[ -z \$id ]]; then id=\$(xcrun simctl create "\$1" "\$2"); fi
state=\$(xcrun simctl list devices -j | jq -r --arg u "\$id" '.devices[][] | select(.udid == \$u) | .state')
if [[ \$state != Booted ]]; then xcrun simctl boot "\$id"; fi
xcrun simctl bootstatus "\$id" -b >/dev/null
echo "\$id"
EOF
}

install() {
  remote "$device" <<EOF
$prelude
id=\$(udid "\$1")
app=~/$remote_dir/Dayline.app
chmod +x "\$app/Dayline" "\$app/PlugIns/DaylineWidget.appex/DaylineWidget"
xcrun simctl install "\$id" "\$app"
echo "installed \$(xcrun simctl get_app_container "\$id" $bundle_id)"
EOF
}

launch() {
  remote "$device" "$@" <<EOF
$prelude
id=\$(udid "\$1")
shift
xcrun simctl terminate "\$id" $bundle_id 2>/dev/null || true
xcrun simctl launch "\$id" $bundle_id "\$@"
EOF
}

screenshot() {
  local out=${1:?usage: sim screenshot <file.png>}
  remote "$device" <<EOF >"$out"
$prelude
id=\$(udid "\$1")
tmp=\$(mktemp -d)/shot.png
xcrun simctl io "\$id" screenshot --type=png "\$tmp" >/dev/null 2>&1
height=\$(sips -g pixelHeight "\$tmp" | awk '/pixelHeight/ { print int(\$2 / 3) }')
sips -Z "\$height" "\$tmp" >/dev/null
cat "\$tmp"
rm -f "\$tmp"
EOF
  echo "$out"
}

ui() {
  remote "$device" <<EOF
$prelude
id=\$(udid "\$1")
axe describe-ui --minimal-keys --udid "\$id" | jq -r '.. | objects | select(.AXLabel != null and .AXLabel != " ") | [(.type // .role_description), .AXLabel, (.AXValue // ""), "\\(.frame.x | floor),\\(.frame.y | floor) \\(.frame.width | floor)x\\(.frame.height | floor)"] | @tsv'
EOF
}

smoke() {
  remote "$device" <<EOF
$prelude
id=\$(udid "\$1")
group=\$(xcrun simctl get_app_container "\$id" $bundle_id group.$bundle_id)
for _ in \$(seq 30); do
  if [[ -s \$group/Snapshots/snapshot-app.json ]]; then
    xcrun simctl spawn "\$id" launchctl list | grep -q "UIKitApplication:$bundle_id" || { echo "app is not running" >&2; exit 1; }
    echo "snapshot written: \$(wc -c <"\$group/Snapshots/snapshot-app.json") bytes"
    exit 0
  fi
  sleep 1
done
echo "no snapshot in \$group" >&2
exit 1
EOF
}

exec_remote() {
  remote "$device" "${1:?usage: sim exec <script using \$SIM>}" <<EOF
$prelude
SIM=\$(udid "\$1")
eval "\$2"
EOF
}

case ${1:-} in
  build) shift; build "$@" ;;
  ship) ship ;;
  boot) boot ;;
  install) install ;;
  launch) shift; launch "$@" ;;
  screenshot) shift; screenshot "$@" ;;
  ui) ui ;;
  smoke) smoke ;;
  exec) shift; exec_remote "$@" ;;
  run) shift; build; ship; boot >/dev/null; install; launch "$@" ;;
  *)
    echo "usage: scripts/sim {build|ship|boot|install|launch [args]|screenshot <png>|ui|smoke|exec <cmd>|run [args]}" >&2
    exit 2
    ;;
esac
